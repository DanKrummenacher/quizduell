{
  "name": "playduelio-frontend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:test": "ng build --configuration test",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:cov": "ng test --watch=false --coverage",
    "test:watch": "ng test",
    "lint": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.ts\" playwright.config.ts",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.ts\" playwright.config.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json && tsc --noEmit -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@css-ch/calc-design-tokens": "^9.0.11",
    "@css-ch/calc-helpers": "^3.0.0",
    "@css-ch/calc-ui-text": "^2.1.17",
    "@css-ch/components": "^2.0.0",
    "@css-ch/design-tokens": "^2.0.1",
    "@css-ch/fonts": "^1.0.2",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true,
    "lmdb": true,
    "msgpackr-extract": true
  }
}
